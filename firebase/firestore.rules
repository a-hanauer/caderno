rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Caderno: uma família = um documento. Só quem sabe o código
    // (20 caracteres aleatórios) lê ou grava. Listar e apagar: proibido.
    match /families/{fid} {
      // Limite de campos (rotina, ajustes, um campo por dia do histórico e por tarefa): impede que alguém com a chave
      // pública do app encha um documento sem fim. 5000 campos = mais de 10 anos de uso normal.
      allow get: if fid.matches('[a-z0-9]{20,40}');
      allow create, update: if fid.matches('[a-z0-9]{20,40}')
        && request.resource.data.size() <= 5000;
    }
  }
}
